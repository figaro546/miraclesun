{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miraclesun",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miraclesun-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "CRM_LOCATION_ID": "xIMotGFTTevHkqMW7hCP"
  },
  "observability": {
    "enabled": true
  }
}
