{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miraclesun",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "site": {
    "bucket": "./public",
    "entry-point": "workers"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miraclesun-db",
      "database_id": "5134d3c9-1e55-4535-9e5a-dcdd64011b28"
    }
  ],
  "vars": {
    "CRM_LOCATION_ID": "xIMotGFTTevHkqMW7hCP"
  },
  "observability": {
    "enabled": true
  }
}
